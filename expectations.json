{
	"test_cases": [
		{
			"id": "contained_inputs",
			"description": "Inputs INSIDE request-header go to that header",
			"form_state": {
				"page": "5",
				"per": "50",
				"view": "list",
				"wait": "",
				"first": "aaa",
				"second": "bbb",
				"status": "",
				"q": ""
			},
			"expected_request": {
				"headers": {
					"Range": "pages=5@50"
				},
				"query_must_not_contain": [
					"page=",
					"per="
				]
			}
		},
		{
			"id": "for_attribute_linking",
			"description": "Inputs with for= attribute link to request-header by id",
			"form_state": {
				"page": "1",
				"per": "25",
				"view": "kanban",
				"wait": "",
				"first": "aaa",
				"second": "bbb",
				"status": "",
				"q": ""
			},
			"expected_request": {
				"headers": {
					"Prefer": "view=kanban",
					"Range": "pages=1@25"
				},
				"query_must_not_contain": [
					"view="
				]
			}
		},
		{
			"id": "append_semantics_prefer",
			"description": "Multiple Prefer headers comma-join (RFC 9110 append)",
			"form_state": {
				"page": "1",
				"per": "25",
				"view": "cards",
				"wait": "30",
				"first": "aaa",
				"second": "bbb",
				"status": "",
				"q": ""
			},
			"expected_request": {
				"headers": {
					"Prefer": "view=cards, wait=30",
					"Range": "pages=1@25"
				}
			}
		},
		{
			"id": "append_skips_empty",
			"description": "Empty values don't appear in comma-joined headers",
			"form_state": {
				"page": "2",
				"per": "10",
				"view": "list",
				"wait": "",
				"first": "aaa",
				"second": "bbb",
				"status": "",
				"q": ""
			},
			"expected_request": {
				"headers": {
					"Prefer": "view=list",
					"Range": "pages=2@10"
				}
			}
		},
		{
			"id": "replace_semantics",
			"description": "Non-append headers use last value (replace semantics)",
			"form_state": {
				"page": "1",
				"per": "25",
				"view": "list",
				"wait": "",
				"first": "aaa",
				"second": "bbb",
				"status": "",
				"q": ""
			},
			"expected_request": {
				"headers": {
					"X-Test-Replace": "second=bbb"
				}
			}
		},
		{
			"id": "filters_to_query",
			"description": "Non-header inputs go to query string",
			"form_state": {
				"page": "1",
				"per": "25",
				"view": "list",
				"wait": "",
				"first": "aaa",
				"second": "bbb",
				"status": "active",
				"q": "test"
			},
			"expected_request": {
				"headers": {
					"Prefer": "view=list",
					"Range": "pages=1@25"
				},
				"query_must_contain": [
					"status=active",
					"q=test"
				],
				"query_must_not_contain": [
					"page=",
					"per=",
					"view=",
					"wait=",
					"first=",
					"second="
				]
			}
		},
		{
			"id": "mixed_all_features",
			"description": "Full integration: contained, for=, append, replace, query",
			"form_state": {
				"page": "3",
				"per": "100",
				"view": "table-rows",
				"wait": "60",
				"first": "xxx",
				"second": "yyy",
				"status": "inactive",
				"q": "acme"
			},
			"expected_request": {
				"headers": {
					"Range": "pages=3@100",
					"Prefer": "view=table-rows, wait=60",
					"X-Test-Replace": "second=yyy"
				},
				"query_must_contain": [
					"status=inactive",
					"q=acme"
				],
				"query_must_not_contain": [
					"page=",
					"per=",
					"view=",
					"wait=",
					"first=",
					"second="
				]
			}
		},
		{
			"id": "namespace_prefixes_contained_fields",
			"description": "fieldset[is=name-space] prefixes its fields as name[field]",
			"form_state": {
				"rate": "0.055",
				"term_months": "36"
			},
			"expected_request": {
				"query_must_contain": [
					"lease%5Brate%5D=0.055",
					"lease%5Bterm_months%5D=36"
				],
				"query_must_not_contain": [
					"rate=0.055",
					"term_months=36"
				]
			}
		},
		{
			"id": "unmarked_named_fieldset_stays_flat",
			"description": "A named fieldset WITHOUT the marker is untouched — the guard that lets this ship without breaking existing forms",
			"form_state": {
				"cost": "999"
			},
			"expected_request": {
				"query_must_contain": [
					"cost=999"
				],
				"query_must_not_contain": [
					"pricing%5Bcost%5D="
				]
			}
		},
		{
			"id": "explicit_action_merges_owned_keys",
			"description": "An explicit action's query is merged: keys the form's controls name are the form's (a namespaced control owns its wire name, a header-bound control its own name); every other key is kept byte-exact and in order",
			"form": "merge",
			"form_state": {
				"stage": "won"
			},
			"checks": {
				"#merge [name=\"region\"][value=\"west\"]": true
			},
			"expected_request": {
				"headers": {
					"X-Rows": "5"
				},
				"query_exact": "keep=a%20b&pred=state%3DCA&stage=won&region=west&lease%5Bterm%5D=36"
			}
		},
		{
			"id": "unchecked_boxes_withdraw_their_key",
			"description": "A control owns its key even when it submits nothing: with every region box unchecked, the action's region=east is withdrawn, not kept",
			"form": "merge",
			"form_state": {},
			"expected_request": {
				"query_exact": "keep=a%20b&pred=state%3DCA&stage=open&lease%5Bterm%5D=36",
				"query_must_not_contain": [
					"region="
				]
			}
		},
		{
			"id": "no_action_keeps_platform_replacement",
			"description": "A form with no action submits to the page's own address and replaces its query, as a native form does, so a self-submitting form cannot accumulate its own keys",
			"form": "self",
			"page_query": "?stale=1",
			"capture_self": true,
			"form_state": {},
			"expected_request": {
				"query_exact": "fresh=1",
				"query_must_not_contain": [
					"stale="
				]
			}
		},
		{
			"id": "query_param_composes_one_pair",
			"description": "A query-param fieldset submits one composed pair; its controls submit nothing of their own; the fieldset owns its key, so the action's copy is withdrawn",
			"form": "compose",
			"form_state": {
				"text": "acme"
			},
			"checks": {
				"#compose [name=\"op\"][value=\"feq\"]": true
			},
			"expected_request": {
				"query_exact": "keep=1&name=feq.acme",
				"query_must_not_contain": [
					"op=",
					"text="
				]
			}
		},
		{
			"id": "query_param_empty_variable_withdraws_the_pair",
			"description": "With every variable empty no composed pair is sent, and the action's copy of each composed key is still withdrawn",
			"form": "compose",
			"form_state": {},
			"expected_request": {
				"query_exact": "keep=1",
				"query_must_not_contain": [
					"name=",
					"amount=",
					"lo=",
					"hi="
				]
			}
		},
		{
			"id": "query_param_range_and_namespace",
			"description": "Two fieldsets sharing a name are two pairs (a range is a conjunction); a composed key inside a name-space fieldset is namespaced like a control",
			"form": "compose",
			"form_state": {
				"lo": "10",
				"hi": "99",
				"months": "12"
			},
			"expected_request": {
				"query_exact": "keep=1&amount=gte.10&amount=lte.99&lease%5Bterm%5D=gte.12",
				"query_must_not_contain": [
					"months=",
					"name="
				]
			}
		},
		{
			"id": "query_param_key_shared_with_the_submitter",
			"description": "A submit button and a checkbox carrying a query-param fieldset's key are sent; the fieldset composes nothing when its variable is empty",
			"form": "compose-shared",
			"form_state": {},
			"checks": {
				"#compose-shared [name=\"tag\"][value=\"x\"]": true
			},
			"expected_request": {
				"query_exact": "keep=1&tag=x&when=not.previous%287%29",
				"query_must_not_contain": [
					"since=",
					"t="
				]
			}
		},
		{
			"id": "innerhtml_takes_the_edition",
			"description": "innerHTML replaces the target's inner HTML: a response rooted at an element carrying the target's own id contributes that element's inner HTML, and does not nest inside the target",
			"form": "edition",
			"form_state": {},
			"expected_request": {
				"dom_counts": {
					"section#panel": 1,
					"section#panel > p.fresh": 1,
					"section#panel > aside": 0,
					"#panel #panel": 0,
					"section#panel > p.stale": 0
				}
			}
		},
		{
			"id": "innerhtml_places_any_other_response_as_before",
			"description": "A response whose root carries a different id is placed inside the target as it always was — the edition rule matches on the target's id only",
			"form": "stranger",
			"form_state": {},
			"expected_request": {
				"dom_counts": {
					"section#panel > aside#other > p.fresh": 1,
					"section#panel > p.stale": 0
				}
			}
		},
		{
			"id": "htmx_interop_names_the_current_page",
			"description": "With http-aware-htmx.js loaded, a request carries HX-Current-URL, the page's own address, as htmx sends it",
			"interop": "http-aware-htmx.js",
			"form_state": {},
			"expected_request": {
				"headers": {
					"HX-Current-URL": "http://localhost:8000/index-standalone.html"
				}
			}
		},
		{
			"id": "patch_cleared_checkbox_sends_empty_value",
			"description": "Under PATCH a box rendered checked and then unchecked is sent as its name with an empty value, and nothing unchanged is sent with it",
			"form": "patch",
			"form_state": {},
			"checks": {
				"#patch [name=\"active\"]": false
			},
			"expected_request": {
				"body_exact": "active="
			}
		},
		{
			"id": "patch_default_follows_what_was_sent",
			"description": "A control outside the swap target takes what was sent as its default once the server accepts it, so checking, unchecking and checking a box again each send a change",
			"form": "patch",
			"steps": [
				{
					"checks": {
						"#patch [name=\"notify\"]": true
					},
					"expected_request": {
						"body_exact": "notify=yes"
					}
				},
				{
					"checks": {
						"#patch [name=\"notify\"]": false
					},
					"expected_request": {
						"body_exact": "notify="
					}
				},
				{
					"checks": {
						"#patch [name=\"notify\"]": true
					},
					"expected_request": {
						"body_exact": "notify=yes"
					}
				}
			]
		},
		{
			"id": "patch_cleared_multiselect_sends_empty_value",
			"description": "A multi-select rendered with options selected and then cleared is sent as its name with an empty value",
			"form": "patch",
			"form_state": {
				"tags": []
			},
			"expected_request": {
				"body_exact": "tags="
			}
		},
		{
			"id": "patch_cleared_namespaced_box_keeps_its_wire_name",
			"description": "The empty value of a cleared box inside a name-space fieldset is sent under the namespaced name its checked value would carry",
			"form": "patch",
			"form_state": {},
			"checks": {
				"#patch [name=\"digest\"]": false
			},
			"expected_request": {
				"body_exact": "prefs%5Bdigest%5D="
			}
		},
		{
			"id": "patch_header_bound_field_stays_out_of_the_body",
			"description": "A changed header-bound field goes to its header and is not put back into the PATCH body as an empty value",
			"form": "patch",
			"form_state": {
				"etag": "v2"
			},
			"checks": {
				"#patch [name=\"notify\"]": true
			},
			"expected_request": {
				"headers": {
					"If-Match": "v2"
				},
				"body_exact": "notify=yes",
				"body_must_not_contain": [
					"etag="
				]
			}
		},
		{
			"id": "patch_composed_variable_stays_out_of_the_body",
			"description": "A cleared variable of a query-param fieldset withdraws its pair and is not put into the PATCH body as an empty value of its own",
			"form": "patch",
			"form_state": {
				"limit": ""
			},
			"checks": {
				"#patch [name=\"notify\"]": true
			},
			"expected_request": {
				"body_exact": "notify=yes",
				"body_must_not_contain": [
					"limit=",
					"cap="
				]
			}
		},
		{
			"id": "patch_refused_change_is_sent_again",
			"description": "A non-2xx PATCH promotes no default: the control is still dirty, and the next submission sends it again",
			"form": "patch-refused",
			"steps": [
				{
					"checks": {
						"#patch-refused [name=\"notify\"]": true
					},
					"expected_request": {
						"body_exact": "notify=yes"
					}
				},
				{
					"expected_request": {
						"body_exact": "notify=yes"
					}
				}
			]
		},
		{
			"id": "htmx_push_url_of_the_current_address_replaces_the_entry",
			"description": "With http-aware-htmx.js loaded, an HX-Push-Url naming the current address replaces the current entry: history gains no entry, so Back leaves the page",
			"interop": "http-aware-htmx.js",
			"page_query": "?at=here",
			"form": "push",
			"form_state": {
				"push": "/index-standalone.html?at=here"
			},
			"expected_request": {
				"history_added": 0,
				"location": "http://localhost:8000/index-standalone.html?at=here",
				"history_state": {}
			}
		},
		{
			"id": "htmx_push_url_of_another_address_adds_an_entry",
			"description": "With http-aware-htmx.js loaded, an HX-Push-Url naming another address adds one entry, so Back returns to the page",
			"interop": "http-aware-htmx.js",
			"page_query": "?at=here",
			"form": "push",
			"form_state": {
				"push": "/index-standalone.html?at=there"
			},
			"expected_request": {
				"history_added": 1,
				"location": "http://localhost:8000/index-standalone.html?at=there",
				"history_state": {}
			}
		},
		{
			"id": "whole_document_at_the_current_address_replaces_the_entry",
			"description": "With no target, an HTML reply from the current address is written into the window and replaces the current entry: history gains no entry",
			"page_query": "?at=here",
			"form": "whole",
			"form_state": {
				"at": "here"
			},
			"expected_request": {
				"history_added": 0,
				"location": "http://localhost:8000/index-standalone.html?at=here"
			}
		},
		{
			"id": "whole_document_at_another_address_adds_an_entry",
			"description": "With no target, an HTML reply from another address is written into the window and adds one entry for it",
			"page_query": "?at=here",
			"form": "whole",
			"form_state": {
				"at": "there"
			},
			"expected_request": {
				"history_added": 1,
				"location": "http://localhost:8000/index-standalone.html?at=there"
			}
		},
		{
			"id": "form_reinserted_submits_once_per_click",
			"description": "A form taken out of the page and put back is wired once: each click sends one request and dispatches one submission, however often the form has been moved",
			"form": "moved",
			"steps": [
				{
					"move": "reinsert",
					"expected_request": {
						"requests": 1,
						"submissions": 1
					}
				},
				{
					"move": "reinsert",
					"expected_request": {
						"requests": 1,
						"submissions": 1
					}
				}
			]
		},
		{
			"id": "form_moved_by_a_morph_submits_once_per_click",
			"description": "A form the library's morph moves with insertBefore is wired once: each click sends one request and dispatches one submission, however often the form has been moved",
			"form": "moved",
			"steps": [
				{
					"move": "morph",
					"expected_request": {
						"requests": 1,
						"submissions": 1
					}
				},
				{
					"move": "morph",
					"expected_request": {
						"requests": 1,
						"submissions": 1
					}
				}
			]
		},
		{
			"id": "autosubmit_form_moved_sends_one_request_per_change",
			"description": "An autosubmit form moved in the page, by reinsertion and then by a morph, sends one request for each change",
			"form": "moved-auto",
			"steps": [
				{
					"move": "reinsert",
					"submit": false,
					"form_state": {
						"shade": "dark"
					},
					"expected_request": {
						"requests": 1,
						"submissions": 1,
						"query_exact": "shade=dark"
					}
				},
				{
					"move": "morph",
					"submit": false,
					"form_state": {
						"shade": "light"
					},
					"expected_request": {
						"requests": 1,
						"submissions": 1,
						"query_exact": "shade=light"
					}
				}
			]
		},
		{
			"id": "oob_marked_outerhtml_replaces_its_element_under_a_retarget",
			"description": "Under a retarget, an element marked data-swap-oob=\"true\" replaces the element on the page carrying its id, and is not put into the primary content",
			"form": "oob-retarget",
			"form_state": {},
			"expected_request": {
				"dom_counts": {
					"section#oob-outer.replaced > p.fresh": 1,
					"#oob-outer > p.stale": 0,
					"#oob-primary #oob-outer": 0
				}
			}
		},
		{
			"id": "oob_marked_innerhtml_fills_and_keeps_its_element_under_a_retarget",
			"description": "Under a retarget, an element marked data-swap-oob=\"innerHTML\" fills the element on the page carrying its id, which keeps its own tag and class, and is not put into the primary content",
			"form": "oob-retarget",
			"form_state": {},
			"expected_request": {
				"dom_counts": {
					"section#oob-inner.shell > p.fresh": 1,
					"#oob-inner > p.stale": 0,
					"aside#oob-inner": 0,
					"#oob-primary #oob-inner": 0
				}
			}
		},
		{
			"id": "oob_marked_with_no_element_on_the_page_is_dropped_under_a_retarget",
			"description": "Under a retarget, a marked element whose id nothing on the page carries is dropped, not made primary content; the primary content still lands in the retargeted element",
			"form": "oob-retarget",
			"form_state": {},
			"expected_request": {
				"dom_counts": {
					"#oob-missing": 0,
					"#oob-primary > p.fresh": 1,
					"#oob-primary > p.stale": 0,
					"#oob-result p": 0
				}
			}
		},
		{
			"id": "unmarked_child_under_a_retarget_stays_primary_content",
			"description": "Under a retarget, an unmarked element whose id is on the page is part of the primary content, as before: it lands in the retargeted element and the page's own element is untouched",
			"form": "oob-retarget",
			"form_state": {},
			"expected_request": {
				"dom_counts": {
					"#oob-primary > section#oob-unmarked > p.fresh": 1,
					"main > section#oob-unmarked > p.stale": 1
				}
			}
		},
		{
			"id": "oob_marked_innerhtml_fills_and_keeps_its_element_without_a_retarget",
			"description": "Without a retarget, an element marked data-swap-oob=\"innerHTML\" fills the element on the page carrying its id and keeps it, rather than replacing it",
			"form": "oob-plain",
			"form_state": {},
			"expected_request": {
				"dom_counts": {
					"section#oob-inner.shell > p.fresh": 1,
					"aside#oob-inner": 0
				}
			}
		},
		{
			"id": "oob_marked_with_no_element_on_the_page_is_dropped_without_a_retarget",
			"description": "Without a retarget, a marked element whose id nothing on the page carries is dropped, not made primary content",
			"form": "oob-plain",
			"form_state": {},
			"expected_request": {
				"dom_counts": {
					"#oob-missing": 0,
					"#oob-primary > p.fresh": 1
				}
			}
		},
		{
			"id": "unmarked_child_with_an_id_on_the_page_stays_out_of_band_without_a_retarget",
			"description": "Without a retarget, an unmarked element whose id is on the page outside the target replaces that element by the id rule, as before",
			"form": "oob-plain",
			"form_state": {},
			"expected_request": {
				"dom_counts": {
					"main > section#oob-unmarked > p.fresh": 1,
					"#oob-primary #oob-unmarked": 0
				}
			}
		}
	],
	"header_format_spec": {
		"Prefer": {
			"pattern": "^view=[a-z-]+(, wait=\\d+)?$",
			"append_semantics": true
		},
		"Range": {
			"pattern": "^pages=\\d+@\\d+$"
		},
		"X-Test-Replace": {
			"replace_semantics": true
		}
	}
}
