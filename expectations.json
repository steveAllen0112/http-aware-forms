{
	"test_cases": [
		{
			"id": "contained_inputs",
			"description": "Inputs INSIDE request-header go to that header",
			"form_state": {
				"page": "5",
				"per": "50",
				"view": "list",
				"wait": "",
				"first": "aaa",
				"second": "bbb",
				"status": "",
				"q": ""
			},
			"expected_request": {
				"headers": {
					"Range": "pages=5@50"
				},
				"query_must_not_contain": [
					"page=",
					"per="
				]
			}
		},
		{
			"id": "for_attribute_linking",
			"description": "Inputs with for= attribute link to request-header by id",
			"form_state": {
				"page": "1",
				"per": "25",
				"view": "kanban",
				"wait": "",
				"first": "aaa",
				"second": "bbb",
				"status": "",
				"q": ""
			},
			"expected_request": {
				"headers": {
					"Prefer": "view=kanban",
					"Range": "pages=1@25"
				},
				"query_must_not_contain": [
					"view="
				]
			}
		},
		{
			"id": "append_semantics_prefer",
			"description": "Multiple Prefer headers comma-join (RFC 9110 append)",
			"form_state": {
				"page": "1",
				"per": "25",
				"view": "cards",
				"wait": "30",
				"first": "aaa",
				"second": "bbb",
				"status": "",
				"q": ""
			},
			"expected_request": {
				"headers": {
					"Prefer": "view=cards, wait=30",
					"Range": "pages=1@25"
				}
			}
		},
		{
			"id": "append_skips_empty",
			"description": "Empty values don't appear in comma-joined headers",
			"form_state": {
				"page": "2",
				"per": "10",
				"view": "list",
				"wait": "",
				"first": "aaa",
				"second": "bbb",
				"status": "",
				"q": ""
			},
			"expected_request": {
				"headers": {
					"Prefer": "view=list",
					"Range": "pages=2@10"
				}
			}
		},
		{
			"id": "replace_semantics",
			"description": "Non-append headers use last value (replace semantics)",
			"form_state": {
				"page": "1",
				"per": "25",
				"view": "list",
				"wait": "",
				"first": "aaa",
				"second": "bbb",
				"status": "",
				"q": ""
			},
			"expected_request": {
				"headers": {
					"X-Test-Replace": "second=bbb"
				}
			}
		},
		{
			"id": "filters_to_query",
			"description": "Non-header inputs go to query string",
			"form_state": {
				"page": "1",
				"per": "25",
				"view": "list",
				"wait": "",
				"first": "aaa",
				"second": "bbb",
				"status": "active",
				"q": "test"
			},
			"expected_request": {
				"headers": {
					"Prefer": "view=list",
					"Range": "pages=1@25"
				},
				"query_must_contain": [
					"status=active",
					"q=test"
				],
				"query_must_not_contain": [
					"page=",
					"per=",
					"view=",
					"wait=",
					"first=",
					"second="
				]
			}
		},
		{
			"id": "mixed_all_features",
			"description": "Full integration: contained, for=, append, replace, query",
			"form_state": {
				"page": "3",
				"per": "100",
				"view": "table-rows",
				"wait": "60",
				"first": "xxx",
				"second": "yyy",
				"status": "inactive",
				"q": "acme"
			},
			"expected_request": {
				"headers": {
					"Range": "pages=3@100",
					"Prefer": "view=table-rows, wait=60",
					"X-Test-Replace": "second=yyy"
				},
				"query_must_contain": [
					"status=inactive",
					"q=acme"
				],
				"query_must_not_contain": [
					"page=",
					"per=",
					"view=",
					"wait=",
					"first=",
					"second="
				]
			}
		},
		{
			"id": "namespace_prefixes_contained_fields",
			"description": "fieldset[is=name-space] prefixes its fields as name[field]",
			"form_state": {
				"rate": "0.055",
				"term_months": "36"
			},
			"expected_request": {
				"query_must_contain": [
					"lease%5Brate%5D=0.055",
					"lease%5Bterm_months%5D=36"
				],
				"query_must_not_contain": [
					"rate=0.055",
					"term_months=36"
				]
			}
		},
		{
			"id": "unmarked_named_fieldset_stays_flat",
			"description": "A named fieldset WITHOUT the marker is untouched \u2014 the guard that lets this ship without breaking existing forms",
			"form_state": {
				"cost": "999"
			},
			"expected_request": {
				"query_must_contain": [
					"cost=999"
				],
				"query_must_not_contain": [
					"pricing%5Bcost%5D="
				]
			}
		},
		{
			"id": "patch_cleared_checkbox_sends_empty_value",
			"description": "Under PATCH a box rendered checked and then unchecked is sent as its name with an empty value, and nothing unchanged is sent with it",
			"form": "patch",
			"form_state": {},
			"checks": {
				"#patch [name=\"active\"]": false
			},
			"expected_request": {
				"body_exact": "active="
			}
		},
		{
			"id": "patch_default_follows_what_was_sent",
			"description": "A control outside the swap target takes what was sent as its default once the server accepts it, so checking, unchecking and checking a box again each send a change",
			"form": "patch",
			"steps": [
				{
					"checks": {
						"#patch [name=\"notify\"]": true
					},
					"expected_request": {
						"body_exact": "notify=yes"
					}
				},
				{
					"checks": {
						"#patch [name=\"notify\"]": false
					},
					"expected_request": {
						"body_exact": "notify="
					}
				},
				{
					"checks": {
						"#patch [name=\"notify\"]": true
					},
					"expected_request": {
						"body_exact": "notify=yes"
					}
				}
			]
		},
		{
			"id": "patch_cleared_multiselect_sends_empty_value",
			"description": "A multi-select rendered with options selected and then cleared is sent as its name with an empty value",
			"form": "patch",
			"form_state": {
				"tags": []
			},
			"expected_request": {
				"body_exact": "tags="
			}
		},
		{
			"id": "patch_cleared_namespaced_box_keeps_its_wire_name",
			"description": "The empty value of a cleared box inside a name-space fieldset is sent under the namespaced name its checked value would carry",
			"form": "patch",
			"form_state": {},
			"checks": {
				"#patch [name=\"digest\"]": false
			},
			"expected_request": {
				"body_exact": "prefs%5Bdigest%5D="
			}
		},
		{
			"id": "patch_header_bound_field_stays_out_of_the_body",
			"description": "A changed header-bound field goes to its header and is not put back into the PATCH body as an empty value",
			"form": "patch",
			"form_state": {
				"etag": "v2"
			},
			"checks": {
				"#patch [name=\"notify\"]": true
			},
			"expected_request": {
				"headers": {
					"If-Match": "v2"
				},
				"body_exact": "notify=yes",
				"body_must_not_contain": [
					"etag="
				]
			}
		},
		{
			"id": "patch_refused_change_is_sent_again",
			"description": "A non-2xx PATCH promotes no default: the control is still dirty, and the next submission sends it again",
			"form": "patch-refused",
			"steps": [
				{
					"checks": {
						"#patch-refused [name=\"notify\"]": true
					},
					"expected_request": {
						"body_exact": "notify=yes"
					}
				},
				{
					"expected_request": {
						"body_exact": "notify=yes"
					}
				}
			]
		}
	],
	"header_format_spec": {
		"Prefer": {
			"pattern": "^view=[a-z-]+(, wait=\\d+)?$",
			"append_semantics": true
		},
		"Range": {
			"pattern": "^pages=\\d+@\\d+$"
		},
		"X-Test-Replace": {
			"replace_semantics": true
		}
	}
}