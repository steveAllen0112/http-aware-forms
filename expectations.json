		{
			"id": "patch_autosubmit_scripted_step_then_leaving_sends_once",
			"description": "An autosubmit PATCH whose quantity a script steps, firing its own change, sends once: leaving the box afterwards sends nothing, the server having accepted the value",
			"form": "patch-auto",
			"steps": [
				{
					"submit": false,
